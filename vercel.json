{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api.php", "destination": "/api/index.php" },
    { "source": "/setup.php", "destination": "/api/setup.php" }
  ]
}
